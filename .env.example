# Copy this file to .env.local and paste your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional: whisper-1 (default) or gpt-4o-transcribe / gpt-4o-mini-transcribe
TRANSCRIBE_MODEL=whisper-1
# Examiner voice (OpenAI TTS). Female voices: coral (default), nova, shimmer, sage
EXAMINER_VOICE=coral
TTS_MODEL=gpt-4o-mini-tts
