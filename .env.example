# Optional. With a key, the examiner speaks with OpenAI's natural voice; without it, the browser's built-in voice is used.
# Copy to .env.local and paste your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Female voices: coral (default), nova, shimmer, sage
EXAMINER_VOICE=coral
TTS_MODEL=gpt-4o-mini-tts
